rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Índice DNI -> mail para poder loguear y recuperar la contraseña con DNI.
    // Se puede leer de a un DNI exacto sin sesión, pero no listar entero.
    // Solo se crea (nunca se pisa) y únicamente apuntando al mail de la propia
    // cuenta, o desde una cuenta vieja (mail interno) para su propio DNI.
    match /dniLookup/{dni} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && (
        request.resource.data.email == request.auth.token.email ||
        request.auth.token.email == dni + '@escuelita-bicentenario-log.local'
      );
      allow update, delete: if false;
    }

    // ponytail: el resto es "todo o nada" — cualquier usuario logueado (alumno,
    // médico o admin) puede leer y escribir cualquier colección. No hay
    // backend (Cloud Functions) para validar por rol server-side, así que
    // permisos más finos (ej. "un médico solo puede calificar a sus propios
    // alumnos") quedan como límite conocido, reforzados solo en la UI.
    // Lo que sí resuelve: nadie no autenticado puede leer o tocar nada.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && collection != 'dniLookup';
    }
  }
}
